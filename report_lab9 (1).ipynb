      "cell_type": "markdown",
      "source": [
        "## Zadanie 3 - Klasyfikacja sentymentu\n",
        "Porównanie skuteczności klasyfikacji (Accuracy) przy użyciu regresji logistycznej dla czterech reprezentacji tekstowych."
      ],
      "metadata": {
        "id": "hapdq9rlm1mh"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "results_zad3 = {}\n",
        "\n",
        "# Modele TF-IDF\n",
        "for method_name, texts in [(\"Surowy tekst\", texts_raw), (\"Stemming\", texts_stem), (\"Lematyzacja\", texts_lemma)]:\n",
        "    X_train, X_test, y_train, y_test = train_test_split(texts, labels, test_size=0.2, random_state=42, stratify=labels)\n",
        "    pipe = Pipeline([\n",
        "        (\"tfidf\", TfidfVectorizer(max_features=10000, ngram_range=(1, 2))),\n",
